{% extends "base.html" %}
{% block content %}
<h1 class="text-xl font-bold">Edit Feed Profile</h1>
<a href="/feed/{{ profile.horse_id }}" class="text-blue-500 text-sm">← Back</a>
<form method="POST" action="/edit_feed/{{ profile.id }}" class="mt-4">
  <input name="hay_type" value="{{ profile.hay_type or '' }}" placeholder="Hay type" class="border p-2 w-full mb-2 rounded">
  <input name="hay_amount" value="{{ profile.hay_amount or '' }}" placeholder="Hay amount" class="border p-2 w-full mb-2 rounded">
  <input name="grain_type" value="{{ profile.grain_type or '' }}" placeholder="Grain type" class="border p-2 w-full mb-2 rounded">
  <input name="grain_amount" value="{{ profile.grain_amount or '' }}" placeholder="Grain amount" class="border p-2 w-full mb-2 rounded">
  <input name="supplements" value="{{ profile.supplements or '' }}" placeholder="Supplements" class="border p-2 w-full mb-2 rounded">
  <textarea name="notes" placeholder="Notes" class="border p-2 w-full mb-2 rounded">{{ profile.notes or '' }}</textarea>
  <input name="cost_per_month" type="number" step="0.01" value="{{ profile.cost_per_month or '' }}" placeholder="Cost per month ($)" class="border p-2 w-full mb-2 rounded">
  <button class="bg-green-500 text-white p-2 w-full rounded">Save</button>
</form>
{% endblock %}
